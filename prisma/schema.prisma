// Data flows in three tiers:
//   1. Submittable (external, read-only after import) — SubmittableSubmission,
//      SubmittableLabel, SubmissionLabel, SubmissionFile mirror data pulled
//      once from the Submittable API (see scripts/dry-run.ts,
//      process-submission.ts) and are never written back to Submittable.
//   2. Generated (write-once, by the processing pipeline) — ArtAsset rows,
//      one per rendered PDF page or uploaded image, with computed
//      thumbnails, extracted text, and page classification.
//   3. Local review state (mutable, this app's own workflow) — the
//      recommendation/visibility/note/audit fields layered on top of 1 and
//      2, written via src/lib/actions/mutations.ts.
// SharedArtworkLink doesn't fit any of the three tiers above — it's a
// standalone, revocable public-sharing artifact (see its own doc comment
// and docs/ARCHITECTURE.md#sharing-an-artwork-outside-the-tool), written
// via src/lib/actions/sharePreview.ts.
//
// None of these "enum-like" string fields are real Postgres/Prisma enums —
// validity is enforced only in TypeScript. Valid values, confirmed against
// actual usage in the codebase:
//   syncStatus:                 "pending" | "synced" | "error"
//   processingStatus:           "pending" | "processing" | "processed" | "error"
//   pageType:                   "artwork" | "cover_statement" | "cv_bio" | "contact_sheet" | "unknown"
//   localReviewRecommendation:  "accept" | "consider_or_delayed_accept" | "tiered_reject" | "reject" | "unreviewed"
//   usedState:                  "available" | "candidate" | "reserved" | "selected" | "published" | "do_not_use"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A Submittable submission (one artist's entry to a project). Imported
/// once via scripts/process-submission.ts; artist/title/coverLetter fields
/// are never updated after that — edit locally via ArtAsset/ReviewAction
/// instead of trying to sync changes back.
model SubmittableSubmission {
  id                        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submittableId             String            @unique @map("submittable_id")
  submittableUrl            String?           @map("submittable_url")
  projectId                 String?           @map("project_id")
  projectName               String?           @map("project_name")
  formId                    String?           @map("form_id")
  formName                  String?           @map("form_name")
  artistName                String?           @map("artist_name")
  artistEmail               String?           @map("artist_email")
  artistPhone               String?           @map("artist_phone")
  artistWebsite             String?           @map("artist_website")
  submissionTitle           String?           @map("submission_title")
  coverLetter               String?           @map("cover_letter")
  artistStatement           String?           @map("artist_statement")
  officialStatus            String?           @map("official_status")
  localReviewRecommendation String            @default("unreviewed") @map("local_review_recommendation")
  needsSubmittableUpdate    Boolean           @default(false) @map("needs_submittable_update")
  submittableUpdateDone     Boolean           @default(false) @map("submittable_update_done")
  submittableUpdateDoneAt   DateTime?         @map("submittable_update_done_at") @db.Timestamptz(6)
  thumbnailAssetId          String?           @map("thumbnail_asset_id") @db.Uuid
  rawSubmissionJson         Json?             @map("raw_submission_json")
  rawEntriesJson            Json?             @map("raw_entries_json")
  syncStatus                String            @default("pending") @map("sync_status")
  processingStatus          String            @default("pending") @map("processing_status")
  processingError           String?           @map("processing_error")
  lastSyncedAt              DateTime?         @map("last_synced_at") @db.Timestamptz(6)
  createdAt                 DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  assets                    ArtAsset[]        @relation("SubmissionAssets")
  actions                   ReviewAction[]
  notes                     ReviewNote[]
  files                     SubmissionFile[]
  labels                    SubmissionLabel[]
  // onDelete: SetNull matches the live constraint (verified directly
  // against pg_constraint, not inferred) — deleting the referenced ArtAsset
  // clears this rather than being blocked. scripts/process-submission.ts's
  // replaceFileAssets relies on this: reprocessing a file deletes and
  // recreates its assets, and a curator-selected thumbnail pointing at one
  // of the old rows needs to survive that as a cleared reference, not a
  // failed transaction.
  thumbnailAsset            ArtAsset?         @relation("SubmissionThumbnail", fields: [thumbnailAssetId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_thumbnail_asset")

  @@index([syncStatus, processingStatus], map: "idx_submittable_submissions_status")
  @@map("submittable_submissions")
}

/// A label as defined in Submittable (e.g. "Consider", "Landscape").
/// Imported by scripts/dry-run.ts into fixtures/labels.json, then upserted
/// here by process-submission.ts.
model SubmittableLabel {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submittableLabelId String            @unique @map("submittable_label_id")
  name               String
  color              String?
  rawJson            Json?             @map("raw_json")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  submissions        SubmissionLabel[]

  @@map("submittable_labels")
}

/// Join table: which labels apply to which submission.
model SubmissionLabel {
  submissionId String                @map("submission_id") @db.Uuid
  labelId      String                @map("label_id") @db.Uuid
  source       String                @default("submittable")
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  label        SubmittableLabel      @relation(fields: [labelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  submission   SubmittableSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([submissionId, labelId])
  @@index([labelId], map: "idx_submission_labels_label_id")
  @@map("submission_labels")
}

/// One uploaded file (PDF or image) attached to a submission, as delivered
/// by Submittable. A single file can expand into multiple ArtAsset rows —
/// one per PDF page, or one for a plain image upload.
model SubmissionFile {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId        String                @map("submission_id") @db.Uuid
  entryId             String                @map("entry_id")
  fileId              String                @map("file_id")
  fieldId             String?               @map("field_id")
  originalFilename    String?               @map("original_filename")
  mimeType            String?               @map("mime_type")
  fileSizeBytes       BigInt?               @map("file_size_bytes")
  storagePathOriginal String                @map("storage_path_original")
  downloadedAt        DateTime?             @map("downloaded_at") @db.Timestamptz(6)
  processingStatus    String                @default("pending") @map("processing_status")
  processingError     String?               @map("processing_error")
  rawFileJson         Json?                 @map("raw_file_json")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  assets              ArtAsset[]
  submission          SubmittableSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([submissionId, entryId, fileId])
  @@index([submissionId], map: "idx_submission_files_submission_id")
  @@map("submission_files")
}

/// One page/image an editor can actually look at — a rendered PDF page or
/// an uploaded image. This is what the Art Library grid and lightbox show;
/// SubmittableSubmission/SubmissionFile are the "why this exists" ancestry,
/// ArtAsset is the "what you see."
model ArtAsset {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId         String                  @map("submission_id") @db.Uuid
  submissionFileId     String?                 @map("submission_file_id") @db.Uuid
  assetType            String                  @map("asset_type")
  pageNumber           Int?                    @map("page_number")
  fileIndex            Int?                    @map("file_index")
  storagePathLarge     String                  @map("storage_path_large")
  storagePathThumbnail String                  @map("storage_path_thumbnail")
  width                Int?                    @map("width")
  height               Int?                    @map("height")
  aspectRatio          Float?                  @map("aspect_ratio")
  extractedText        String?                 @map("extracted_text")
  pageType             String                  @default("unknown") @map("page_type")
  visibleInArtLibrary  Boolean                 @default(true) @map("visible_in_art_library")
  /// Reserved for future manual metadata entry — not currently read or
  /// written anywhere in the app or scripts (verified 2026-08).
  localTitle           String?                 @map("local_title")
  /// Reserved, same as localTitle.
  medium               String?                 @map("medium")
  /// Reserved, same as localTitle.
  dimensions           String?                 @map("dimensions")
  /// Reserved, same as localTitle.
  year                 String?                 @map("year")
  usedState            String                  @default("available") @map("used_state")
  /// JSON-stringified TagResult (see scripts/tag-all-artwork.ts), not a
  /// native Json column — parsed by hand in getAssets.ts into a typed
  /// shape. Written once by the tagging script; null means untagged.
  autoGeneratedTags    String?                 @map("auto_generated_tags")
  rawProcessingJson    Json?                   @map("raw_processing_json")
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  submissionFile       SubmissionFile?         @relation(fields: [submissionFileId], references: [id], onUpdate: NoAction)
  submission           SubmittableSubmission   @relation("SubmissionAssets", fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actions              ReviewAction[]
  notes                ReviewNote[]
  thumbnailFor         SubmittableSubmission[] @relation("SubmissionThumbnail")
  sharedLink           SharedArtworkLink?

  @@index([pageType], map: "idx_art_assets_page_type")
  @@index([submissionId], map: "idx_art_assets_submission_id")
  @@map("art_assets")
}

/// A revocable, expiring public link exposing exactly one ArtAsset's image
/// plus its artist name and piece title, reachable without login — see
/// src/proxy.ts's exemption for /share and src/lib/sharePreview.ts for the
/// single authorization decision both /share/[token] and its image route
/// apply. Created explicitly via "Copy share link" in the review UI, never
/// automatically. One row per asset (@unique on artAssetId): creating a new
/// link for an asset that already has one overwrites it in place, so the
/// old token stops resolving immediately — there is no separate "revoke"
/// action, just "share again". Only tokenHash is stored, never the raw
/// token — it exists in plaintext only in the URL handed to the user, so a
/// database leak alone can't produce a usable link.
model SharedArtworkLink {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  artAssetId String    @unique @map("art_asset_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  artAsset   ArtAsset  @relation(fields: [artAssetId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("shared_artwork_links")
}

/// A free-text note an editor leaves on a submission (optionally scoped to
/// one asset/page). Written by addReviewNote(); never edited or deleted
/// through the UI — this is an append-only log, not a scratchpad.
model ReviewNote {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId String                @map("submission_id") @db.Uuid
  artAssetId   String?               @map("art_asset_id") @db.Uuid
  userId       String?               @map("user_id") @db.Uuid
  note         String
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  artAsset     ArtAsset?             @relation(fields: [artAssetId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  submission   SubmittableSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("review_notes")
}

/// Append-only audit log — one row per state change made through
/// src/lib/actions/mutations.ts (see that file's header for which
/// mutations write here). previousValue/newValue capture just the changed
/// field(s), not a full snapshot. No retention/cleanup policy exists; this
/// table grows unbounded.
model ReviewAction {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId  String                @map("submission_id") @db.Uuid
  artAssetId    String?               @map("art_asset_id") @db.Uuid
  userId        String?               @map("user_id") @db.Uuid
  actionType    String                @map("action_type")
  previousValue Json?                 @map("previous_value")
  newValue      Json?                 @map("new_value")
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  artAsset      ArtAsset?             @relation(fields: [artAssetId], references: [id], onUpdate: NoAction)
  submission    SubmittableSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("review_actions")
}
