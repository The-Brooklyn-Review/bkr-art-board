# Supabase Postgres — see docs/OPERATIONS.md
DATABASE_URL=
DIRECT_URL=

# Cloudflare R2 — private object storage for rendered images
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=

# Shared login password for the app
APP_PASSWORD=

# Submittable API — only needed to run the importer (scripts/dry-run.ts, scripts/process-submission.ts)
SUBMITTABLE_API_KEY=
SUBMITTABLE_API_BASE_URL=
SUBMITTABLE_WEB_BASE_URL=

# Import filter overrides — all optional; leave blank for the defaults
# (every non-archived project containing "visual arts", every submission not
# yet completed/accepted/declined/withdrawn). See scripts/dry-run.ts header.
ART_LIBRARY_PROJECT_NAME_PATTERN=
ART_LIBRARY_PROJECT_NAME=
ART_LIBRARY_EXCLUDED_STATUSES=
ART_LIBRARY_REQUIRED_STATUS=
ART_LIBRARY_REQUIRED_LABEL=
ART_LIBRARY_EXPECTED_SUBMISSION_COUNT=

# Claude API — only needed to run scripts/tag-all-artwork.ts
ANTHROPIC_API_KEY=
